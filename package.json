{
  "name": "capacitor-kotlin-multi-platform",
  "version": "0.1.0",
  "description": "Kotlin Multiplatform for Capacitor: write plugin logic once in Kotlin and run it on Android, iOS and the Web. Base framework for KMP-powered Capacitor plugins.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "ios/Frameworks/",
    "kmp-repo/",
    "kmp/build-logic/build.gradle.kts",
    "kmp/build-logic/settings.gradle.kts",
    "kmp/build-logic/src/",
    "kmp/gradle/",
    "kmp/gradlew",
    "kmp/gradlew.bat",
    "kmp/gradle.properties",
    "docs/",
    "Package.swift",
    "CapacitorKotlinMultiPlatform.podspec"
  ],
  "author": "Dave Alden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpa99c/capacitor-kotlin-multi-platform.git"
  },
  "bugs": {
    "url": "https://github.com/dpa99c/capacitor-kotlin-multi-platform/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "kotlin",
    "kotlin-multiplatform",
    "kmp"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorKotlinMultiPlatform -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "kmp:build": "cd kmp && ./gradlew capacitorExport",
    "kmp:test": "cd kmp && ./gradlew allTests",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorKmpPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run kmp:build && npm run build:web",
    "build:web": "npm run clean && npm run docgen && tsc && node scripts/copy-kmp-js.mjs && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
